{
	"name": "chrome-title-extension",
	"version": "0.0.5",
	"description": "A chrome extension to get the title of the current page and copy it to the clipboard",
	"keywords": [
		"background",
		"browser-extension",
		"chrome-extension",
		"clipboard",
		"content-script",
		"extension",
		"manifest",
		"popup",
		"title",
		"typescript"
	],
	"license": "MIT",
	"author": "heiwa4126 <heiwa4126@gmail.com>",
	"type": "module",
	"main": "index.js",
	"scripts": {
		"build": "tsdown",
		"format": "oxfmt",
		"lint": "oxlint",
		"check": "oxfmt && oxlint --fix",
		"lint:me": "me lint .",
		"test": "echo \"Error: no test specified\" && exit 1",
		"release:zip": "sh scripts/release-zip.sh",
		"release": "run-s lint build release:zip",
		"start": "http-server demo -p 3000",
		"trivy": "trivy config . && trivy fs --exit-code 1 --severity HIGH,CRITICAL .",
		"sbom": "trivy fs --scanners vuln --format spdx-json --output sbom.spdx.json .",
		"osv-scan": "osv-scanner .",
		"cloc": "cloc $(git ls-files|grep -Fv pnpm-lock.yaml)",
		"lizard": "lizard -EDuplicate -w ."
	},
	"devDependencies": {
		"@types/chrome": "^0.3.7",
		"esbuild": "^0.28.2",
		"fx": "^40.0.1",
		"http-server": "^14.1.1",
		"npm-run-all2": "^9.0.4",
		"tsdown": "^0.23.7",
		"typescript": "^7.0.2"
	},
	"packageManager": "pnpm@10.24.0"
}
